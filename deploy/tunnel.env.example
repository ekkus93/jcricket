# Copy to a protected operator-only path such as /etc/second-brain/tunnel.env
# (owner root:second-brain-tunnel, mode 0600). This committed example contains
# placeholders only. Full procedure: docs/integrations/local-clients.md.
#
# Values containing spaces must stay quoted for systemd's EnvironmentFile.

# Restricted OpenAI runtime key with Tunnels Read + Use (not an admin key).
CONTROL_PLANE_API_KEY=REPLACE_WITH_RUNTIME_API_KEY
CONTROL_PLANE_TUNNEL_ID=tunnel_REPLACE_WITH_TUNNEL_ID

# The dedicated `chatgpt` principal's token (same value as CHATGPT_MCP_TOKEN in
# the server's credentials file), as a complete Authorization header value.
# The tunnel profile refers to it by name:
#   mcp:
#     extra_headers:
#       Authorization: "env:SECOND_BRAIN_UPSTREAM_AUTH"
SECOND_BRAIN_UPSTREAM_AUTH="Bearer REPLACE_WITH_CHATGPT_MCP_TOKEN"

# Keep the tunnel-client health/admin listener on loopback.
HEALTH_LISTEN_ADDR=127.0.0.1:18081

# OPENAI_ADMIN_KEY is not required for the normal tunnel runtime.
