# Example Nginx location for an OAuth-aware reverse proxy deployment.
# Replace hostnames and certificate paths. Configure the chosen OAuth gateway
# to validate tokens and map each account to a distinct principal before proxying.
server {
    listen 443 ssl http2;
    server_name second-brain.example.invalid;
    ssl_certificate /etc/letsencrypt/live/second-brain.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/second-brain.example.invalid/privkey.pem;

    client_max_body_size 256k;
    location = /mcp {
        proxy_pass http://127.0.0.1:8000/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:8000;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 310s;
        proxy_send_timeout 310s;
        proxy_buffering off;
    }
}
