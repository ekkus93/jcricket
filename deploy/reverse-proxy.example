# NON-FUNCTIONAL until SB-041/SB-042 are complete. This is a deployment sketch only.
# Local bearer tokens are not remote authentication, and remote Origin policy is
# not defined. Configure a trusted remote principal design before enabling it.
server {
    listen 443 ssl http2;
    server_name second-brain.example.invalid;
    ssl_certificate /etc/letsencrypt/live/second-brain.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/second-brain.example.invalid/privkey.pem;

    client_max_body_size 256k;
    location = /mcp {
        proxy_pass http://127.0.0.1:18765/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # nginx forwards client headers by default; clear Authorization so local
        # bearer tokens can never be used through this proxy.
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 310s;
        proxy_send_timeout 310s;
        proxy_buffering off;
    }
}
